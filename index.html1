<!DOCTYPE html>
<html lang="pl" class="h-full bg-slate-900 text-slate-100">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>FotoDruk Pro - Generator Zdjęć do Druku</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- jsPDF do generowania PDF -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    body {
      font-family: 'Inter', sans-serif;
      touch-action: manipulation;
    }
    .no-scroll {
      touch-action: none;
    }
    .step-active {
      border-color: #3b82f6;
      color: #60a5fa;
    }
    .step-done {
      border-color: #10b981;
      color: #34d399;
      background-color: rgba(16, 185, 129, 0.1);
    }
  </style>
</head>
<body class="h-full flex flex-col justify-between overflow-x-hidden select-none">

  <!-- Header -->
  <header class="bg-slate-800/80 backdrop-blur border-b border-slate-700/50 p-4 sticky top-0 z-50">
    <div class="max-w-md mx-auto flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="p-2 bg-blue-600 rounded-xl shadow-lg shadow-blue-500/30">
          <i data-lucide="printer" class="w-5 h-5 text-white"></i>
        </div>
        <h1 class="font-bold text-lg leading-tight bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">
          FotoDruk Pro
        </h1>
      </div>
      <span id="step-indicator-text" class="text-xs font-semibold px-2.5 py-1 bg-slate-700/60 rounded-full text-slate-300">
        Krok 1 z 5
      </span>
    </div>
  </header>

  <!-- Pasek Postępu Kroku -->
  <nav class="bg-slate-800/40 border-b border-slate-800 py-2 px-4 overflow-x-auto">
    <div class="max-w-md mx-auto flex items-center justify-between min-w-[300px]">
      <div id="wizard-step-1" class="step-active flex flex-col items-center flex-1 border-b-2 pb-1 text-xs font-medium transition-all">
        <span class="w-5 h-5 rounded-full border flex items-center justify-center text-[10px] mb-1">1</span>
        Papier
      </div>
      <div id="wizard-step-2" class="border-slate-700 text-slate-500 flex flex-col items-center flex-1 border-b-2 pb-1 text-xs font-medium transition-all">
        <span class="w-5 h-5 rounded-full border flex items-center justify-center text-[10px] mb-1">2</span>
        Zdjęcie
      </div>
      <div id="wizard-step-3" class="border-slate-700 text-slate-500 flex flex-col items-center flex-1 border-b-2 pb-1 text-xs font-medium transition-all">
        <span class="w-5 h-5 rounded-full border flex items-center justify-center text-[10px] mb-1">3</span>
        Kadrowanie
      </div>
      <div id="wizard-step-4" class="border-slate-700 text-slate-500 flex flex-col items-center flex-1 border-b-2 pb-1 text-xs font-medium transition-all">
        <span class="w-5 h-5 rounded-full border flex items-center justify-center text-[10px] mb-1">4</span>
        Arkusz
      </div>
      <div id="wizard-step-5" class="border-slate-700 text-slate-500 flex flex-col items-center flex-1 border-b-2 pb-1 text-xs font-medium transition-all">
        <span class="w-5 h-5 rounded-full border flex items-center justify-center text-[10px] mb-1">5</span>
        Pobierz
      </div>
    </div>
  </nav>

  <!-- Treść Kroku -->
  <main class="flex-1 max-w-md w-full mx-auto p-4 flex flex-col justify-center">

    <!-- KROK 1: Wybór rozmiaru papieru -->
    <section id="step-1" class="space-y-4">
      <div class="text-center mb-4">
        <h2 class="text-xl font-bold text-white mb-1">Wybierz format papieru</h2>
        <p class="text-xs text-slate-400">Na jakim arkuszu będziesz drukować zdjęcia?</p>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <button onclick="selectPaperPreset(210, 297, 'A4')" class="paper-preset p-4 rounded-2xl bg-slate-800 border-2 border-slate-700 hover:border-blue-500 flex flex-col items-center text-center transition active:scale-95">
          <i data-lucide="file" class="w-8 h-8 mb-2 text-blue-400"></i>
          <span class="font-bold text-sm">A4</span>
          <span class="text-xs text-slate-400">210 × 297 mm</span>
        </button>

        <button onclick="selectPaperPreset(100, 150, '10x15')" class="paper-preset p-4 rounded-2xl bg-slate-800 border-2 border-slate-700 hover:border-blue-500 flex flex-col items-center text-center transition active:scale-95">
          <i data-lucide="camera" class="w-8 h-8 mb-2 text-amber-400"></i>
          <span class="font-bold text-sm">10 × 15 cm</span>
          <span class="text-xs text-slate-400">100 × 150 mm</span>
        </button>

        <button onclick="selectPaperPreset(89, 127, 'L')" class="paper-preset p-4 rounded-2xl bg-slate-800 border-2 border-slate-700 hover:border-blue-500 flex flex-col items-center text-center transition active:scale-95">
          <i data-lucide="image" class="w-8 h-8 mb-2 text-indigo-400"></i>
          <span class="font-bold text-sm">Format L</span>
          <span class="text-xs text-slate-400">89 × 127 mm</span>
        </button>

        <button onclick="selectPaperPreset(127, 178, '2L')" class="paper-preset p-4 rounded-2xl bg-slate-800 border-2 border-slate-700 hover:border-blue-500 flex flex-col items-center text-center transition active:scale-95">
          <i data-lucide="images" class="w-8 h-8 mb-2 text-emerald-400"></i>
          <span class="font-bold text-sm">Format 2L</span>
          <span class="text-xs text-slate-400">127 × 178 mm</span>
        </button>
      </div>

      <!-- Własne wymiary papieru -->
      <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-700 space-y-3">
        <div class="flex items-center gap-2">
          <i data-lucide="sliders" class="w-4 h-4 text-blue-400"></i>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">Własny rozmiar arkusza (mm)</span>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">Szerokość (mm)</label>
            <input type="number" id="paper-width" value="210" min="20" max="1000" onchange="saveCustomDimensions()" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-center font-semibold focus:outline-none focus:border-blue-500">
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">Wysokość (mm)</label>
            <input type="number" id="paper-height" value="297" min="20" max="1000" onchange="saveCustomDimensions()" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-center font-semibold focus:outline-none focus:border-blue-500">
          </div>
        </div>
      </div>
    </section>

    <!-- KROK 2: Wybór rozmiaru zdjęcia -->
    <section id="step-2" class="space-y-4 hidden">
      <div class="text-center mb-2">
        <h2 class="text-xl font-bold text-white mb-1">Wybierz typ zdjęcia</h2>
        <p class="text-xs text-slate-400">Wybierz przeznaczenie lub wpisz własne wymiary</p>
      </div>

      <div class="space-y-2.5">
        <!-- Dowód osobisty -->
        <button onclick="selectPhotoPreset(35, 45, 'Dowód osobisty', 'dowod')" class="w-full p-3.5 rounded-2xl bg-slate-800 border-2 border-slate-700 hover:border-blue-500 text-left transition active:scale-[0.98] flex items-start gap-3">
          <div class="p-2.5 bg-blue-500/10 rounded-xl text-blue-400 mt-0.5">
            <i data-lucide="id-card" class="w-6 h-6"></i>
          </div>
          <div class="flex-1">
            <div class="flex justify-between items-center mb-0.5">
              <span class="font-bold text-sm text-white">Dowód osobisty</span>
              <span class="text-xs font-bold text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded-md">35 × 45 mm</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-tight">
              <strong>Zdjęcie biometryczne (TAK):</strong> bez nakrycia głowy, jasne tło, twarz zajmuje 70–80% wysokości zdjęcia (głowa 31–36 mm).
            </p>
          </div>
        </button>

        <!-- Paszport -->
        <button onclick="selectPhotoPreset(35, 45, 'Paszport', 'paszport')" class="w-full p-3.5 rounded-2xl bg-slate-800 border-2 border-slate-700 hover:border-blue-500 text-left transition active:scale-[0.98] flex items-start gap-3">
          <div class="p-2.5 bg-emerald-500/10 rounded-xl text-emerald-400 mt-0.5">
            <i data-lucide="file-badge-2" class="w-6 h-6"></i>
          </div>
          <div class="flex-1">
            <div class="flex justify-between items-center mb-0.5">
              <span class="font-bold text-sm text-white">Paszport</span>
              <span class="text-xs font-bold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded-md">35 × 45 mm</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-tight">
              <strong>Zdjęcie biometryczne (TAK):</strong> wymagania dokładnie takie same jak do dowodu osobistego (70–80% wysokości na twarz).
            </p>
          </div>
        </button>

        <!-- Legitymacja szkolna -->
        <button onclick="selectPhotoPreset(30, 42, 'Legitymacja szkolna', 'legitymacja')" class="w-full p-3.5 rounded-2xl bg-slate-800 border-2 border-slate-700 hover:border-blue-500 text-left transition active:scale-[0.98] flex items-start gap-3">
          <div class="p-2.5 bg-amber-500/10 rounded-xl text-amber-400 mt-0.5">
            <i data-lucide="graduation-cap" class="w-6 h-6"></i>
          </div>
          <div class="flex-1">
            <div class="flex justify-between items-center mb-0.5">
              <span class="font-bold text-sm text-white">Legitymacja szkolna</span>
              <span class="text-xs font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded-md">30 × 42 mm</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-tight">
              <strong>Zdjęcie biometryczne (NIE):</strong> mniejszy format, zdjęcie wyraźne, na jasnym jednolicie oświetlonym tle.
            </p>
          </div>
        </button>

        <!-- Wiza USA -->
        <button onclick="selectPhotoPreset(51, 51, 'Wiza USA (2×2 cale)', 'wiza_usa')" class="w-full p-3.5 rounded-2xl bg-slate-800 border-2 border-slate-700 hover:border-blue-500 text-left transition active:scale-[0.98] flex items-start gap-3">
          <div class="p-2.5 bg-purple-500/10 rounded-xl text-purple-400 mt-0.5">
            <i data-lucide="globe" class="w-6 h-6"></i>
          </div>
          <div class="flex-1">
            <div class="flex justify-between items-center mb-0.5">
              <span class="font-bold text-sm text-white">Wiza USA</span>
              <span class="text-xs font-bold text-purple-400 bg-purple-500/10 px-2 py-0.5 rounded-md">51 × 51 mm (2×2")</span>
            </div>
            <p class="text-[11px] text-slate-300 leading-tight">
              <strong>Zdjęcie biometryczne (TAK):</strong> format kwadratowy, głowa zajmuje 25–35 mm (50–69% wysokości), tło białe/Off-White.
            </p>
          </div>
        </button>
      </div>

      <!-- Własne wymiary zdjęcia -->
      <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-700 space-y-3">
        <div class="flex items-center gap-2">
          <i data-lucide="crop" class="w-4 h-4 text-blue-400"></i>
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-300">Własny format zdjęcia (mm)</span>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block text-xs text-slate-400 mb-1">Szerokość (mm)</label>
            <input type="number" id="photo-width" value="35" min="10" max="300" onchange="saveCustomDimensions(); setPresetCustom();" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-center font-semibold focus:outline-none focus:border-blue-500">
          </div>
          <div>
            <label class="block text-xs text-slate-400 mb-1">Wysokość (mm)</label>
            <input type="number" id="photo-height" value="45" min="10" max="300" onchange="saveCustomDimensions(); setPresetCustom();" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-3 py-2 text-sm text-center font-semibold focus:outline-none focus:border-blue-500">
          </div>
        </div>
      </div>
    </section>

    <!-- KROK 3: Kadrowanie & Wgrywanie zdjęcia -->
    <section id="step-3" class="space-y-4 hidden">
      <div class="text-center mb-1">
        <h2 class="text-xl font-bold text-white mb-0.5">Dopasuj twarz do ramki</h2>
        <p class="text-xs text-slate-400" id="crop-guideline-text">Ustaw głowę w wyznaczonym obszarze elipsy</p>
      </div>

      <!-- Kontener Canvas -->
      <div class="relative w-full aspect-square max-w-[320px] mx-auto bg-slate-950 rounded-2xl overflow-hidden border-2 border-slate-700 shadow-2xl flex items-center justify-center no-scroll">
        <canvas id="crop-canvas" class="w-full h-full object-contain cursor-grab active:cursor-grabbing"></canvas>

        <div id="crop-placeholder" class="absolute inset-0 flex flex-col items-center justify-center p-6 text-center bg-slate-900/95 backdrop-blur-sm z-10 pointer-events-none">
          <div class="w-16 h-16 rounded-full bg-slate-800 flex items-center justify-center mb-3 text-blue-400">
            <i data-lucide="image-plus" class="w-8 h-8"></i>
          </div>
          <p class="text-sm font-medium text-slate-200">Brak wczytanego zdjęcia</p>
          <p class="text-xs text-slate-400 mt-1">Użyj przycisków poniżej, aby dodać zdjęcie z pliku lub zrobić zdjęcie aparatem.</p>
        </div>
      </div>

      <!-- Suwaki Zoom i Obrotu -->
      <div id="controls-container" class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700 space-y-3 hidden">
        <div>
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span class="flex items-center gap-1"><i data-lucide="zoom-out" class="w-3.5 h-3.5"></i> Oddal</span>
            <span class="font-semibold text-slate-200" id="zoom-value">100%</span>
            <span class="flex items-center gap-1">Przybliż <i data-lucide="zoom-in" class="w-3.5 h-3.5"></i></span>
          </div>
          <input type="range" id="zoom-slider" min="0.2" max="3" step="0.01" value="1" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-500">
        </div>

        <div>
          <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
            <span class="flex items-center gap-1"><i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Obrót</span>
            <span class="font-semibold text-slate-200" id="rotate-value">0°</span>
            <span class="flex items-center gap-1"><i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i></span>
          </div>
          <input type="range" id="rotate-slider" min="-45" max="45" step="1" value="0" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-blue-500">
        </div>
      </div>

      <!-- Przyciski Pobierania/Aparatu -->
      <div class="grid grid-cols-2 gap-3">
        <input type="file" id="file-input" accept="image/*" class="hidden">
        <input type="file" id="camera-input" accept="image/*" capture="user" class="hidden">

        <button onclick="document.getElementById('file-input').click()" class="py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 font-medium text-xs flex items-center justify-center gap-2 transition active:scale-95 shadow-md">
          <i data-lucide="upload" class="w-4 h-4 text-blue-400"></i>
          <span>Wybierz zdjęcie</span>
        </button>

        <button onclick="document.getElementById('camera-input').click()" class="py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 font-medium text-xs flex items-center justify-center gap-2 transition active:scale-95 shadow-md">
          <i data-lucide="camera" class="w-4 h-4 text-emerald-400"></i>
          <span>Otwórz aparat</span>
        </button>
      </div>
    </section>

    <!-- KROK 4: Podgląd Arkusza -->
    <section id="step-4" class="space-y-4 hidden">
      <div class="text-center mb-1">
        <h2 class="text-xl font-bold text-white mb-0.5">Podgląd arkusza do druku</h2>
        <p class="text-xs text-slate-400" id="sheet-info-text">Automatyczne rozmieszczenie zdjęć na kartce</p>
      </div>

      <div class="relative w-full max-w-[340px] mx-auto bg-slate-950 p-3 rounded-2xl border border-slate-800 shadow-2xl flex items-center justify-center overflow-hidden">
        <div id="paper-preview-container" class="relative bg-white shadow-xl transition-all duration-300 flex items-center justify-center overflow-hidden rounded-sm">
          <canvas id="sheet-canvas" class="max-w-full max-h-[380px] object-contain"></canvas>
        </div>
      </div>

      <div class="bg-slate-800/80 p-3 rounded-2xl border border-slate-700 space-y-2">
        <label for="toggle-grid-lines" class="text-xs text-slate-300 flex items-center gap-2 cursor-pointer">
          <input type="checkbox" id="toggle-grid-lines" checked class="w-4 h-4 rounded bg-slate-900 border-slate-700 text-blue-600 focus:ring-0">
          <span>Pokaż pomocnicze linie do cięcia</span>
        </label>
      </div>
    </section>

    <!-- KROK 5: Pobieranie -->
    <section id="step-5" class="space-y-4 hidden">
      <div class="text-center mb-3">
        <div class="w-12 h-12 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center mx-auto mb-2 border border-emerald-500/30">
          <i data-lucide="check-circle-2" class="w-6 h-6"></i>
        </div>
        <h2 class="text-xl font-bold text-white mb-1">Gotowe do pobrania!</h2>
        <p class="text-xs text-slate-400">Pobierz arkusz w wybranym formacie i wydrukuj w 100% skali.</p>
      </div>

      <div class="bg-slate-800/60 p-4 rounded-2xl border border-slate-700 text-xs space-y-2">
        <div class="flex justify-between border-b border-slate-700/60 pb-1.5">
          <span class="text-slate-400">Rozmiar arkusza:</span>
          <span class="font-semibold text-slate-200" id="summary-paper">-</span>
        </div>
        <div class="flex justify-between border-b border-slate-700/60 pb-1.5">
          <span class="text-slate-400">Typ i rozmiar zdjęcia:</span>
          <span class="font-semibold text-slate-200" id="summary-photo">-</span>
        </div>
        <div class="flex justify-between">
          <span class="text-slate-400">Liczba zdjęć na arkuszu:</span>
          <span class="font-bold text-emerald-400" id="summary-count">-</span>
        </div>
      </div>

      <div class="space-y-3 pt-2">
        <button onclick="downloadPDF()" class="w-full py-4 px-4 rounded-xl bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 text-white font-semibold text-sm flex items-center justify-center gap-2 shadow-lg shadow-blue-500/25 transition active:scale-95">
          <i data-lucide="file-down" class="w-5 h-5"></i>
          <span>Pobierz jako plik PDF</span>
        </button>

        <button onclick="downloadImage('jpg')" class="w-full py-3.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-200 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-95">
          <i data-lucide="image" class="w-4 h-4 text-amber-400"></i>
          <span>Pobierz jako obraz JPG (Wysoka Jakość)</span>
        </button>

        <button onclick="downloadImage('png')" class="w-full py-3.5 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-600 text-slate-200 font-semibold text-xs flex items-center justify-center gap-2 transition active:scale-95">
          <i data-lucide="image" class="w-4 h-4 text-emerald-400"></i>
          <span>Pobierz jako obraz PNG</span>
        </button>
      </div>
    </section>

  </main>

  <!-- Dolna Nawigacja -->
  <footer class="bg-slate-800/80 backdrop-blur border-t border-slate-700/50 p-4 sticky bottom-0 z-50">
    <div class="max-w-md mx-auto flex items-center gap-3">
      <button id="btn-prev" onclick="prevStep()" class="py-3 px-4 rounded-xl bg-slate-700 hover:bg-slate-600 text-slate-200 font-medium text-xs flex items-center justify-center gap-1 disabled:opacity-40 disabled:pointer-events-none transition">
        <i data-lucide="arrow-left" class="w-4 h-4"></i>
        <span>Wstecz</span>
      </button>

      <button id="btn-next" onclick="nextStep()" class="flex-1 py-3 px-4 rounded-xl bg-blue-600 hover:bg-blue-500 text-white font-semibold text-xs flex items-center justify-center gap-2 shadow-lg shadow-blue-600/30 transition active:scale-95">
        <span>Dalej</span>
        <i data-lucide="arrow-right" class="w-4 h-4"></i>
      </button>
    </div>
  </footer>

  <!-- Toast Message -->
  <div id="toast" class="fixed top-16 left-1/2 -translate-x-1/2 bg-slate-800 border border-slate-600 text-slate-100 text-xs px-4 py-2.5 rounded-full shadow-xl opacity-0 pointer-events-none transition-all duration-300 z-50 flex items-center gap-2">
    <i data-lucide="info" class="w-4 h-4 text-blue-400"></i>
    <span id="toast-message">Wiadomość</span>
  </div>

  <script>
    let currentStep = 1;

    let paperConfig = {
      width: 210,
      height: 297,
      name: 'A4'
    };

    let photoConfig = {
      width: 35,
      height: 45,
      name: 'Dowód osobisty',
      presetType: 'dowod' // dowod, paszport, legitymacja, wiza_usa, custom
    };

    let loadedImage = null;
    let cropState = {
      x: 0,
      y: 0,
      scale: 1,
      rotation: 0
    };

    let calculatedGrid = {
      cols: 0,
      rows: 0,
      count: 0,
      spacing: 2
    };

    const cropCanvas = document.getElementById('crop-canvas');
    const cropCtx = cropCanvas.getContext('2d');
    const sheetCanvas = document.getElementById('sheet-canvas');
    const sheetCtx = sheetCanvas.getContext('2d');

    window.onload = () => {
      lucide.createIcons();
      loadCustomDimensions();
      setupEventListeners();
      updateStepUI();
    };

    // --- LOCALSTORAGE ---
    function loadCustomDimensions() {
      const savedPaperW = localStorage.getItem('fotodruk_paper_width');
      const savedPaperH = localStorage.getItem('fotodruk_paper_height');
      if (savedPaperW && savedPaperH) {
        document.getElementById('paper-width').value = savedPaperW;
        document.getElementById('paper-height').value = savedPaperH;
      }

      const savedPhotoW = localStorage.getItem('fotodruk_photo_width');
      const savedPhotoH = localStorage.getItem('fotodruk_photo_height');
      if (savedPhotoW && savedPhotoH) {
        document.getElementById('photo-width').value = savedPhotoW;
        document.getElementById('photo-height').value = savedPhotoH;
      }
    }

    function saveCustomDimensions() {
      const paperW = document.getElementById('paper-width').value;
      const paperH = document.getElementById('paper-height').value;
      const photoW = document.getElementById('photo-width').value;
      const photoH = document.getElementById('photo-height').value;

      if (paperW) localStorage.setItem('fotodruk_paper_width', paperW);
      if (paperH) localStorage.setItem('fotodruk_paper_height', paperH);
      if (photoW) localStorage.setItem('fotodruk_photo_width', photoW);
      if (photoH) localStorage.setItem('fotodruk_photo_height', photoH);
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-message').innerText = msg;
      toast.classList.remove('opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('opacity-0', 'pointer-events-none');
      }, 3000);
    }

    function selectPaperPreset(w, h, name) {
      document.getElementById('paper-width').value = w;
      document.getElementById('paper-height').value = h;
      saveCustomDimensions();
      paperConfig.name = name;
      showToast(`Wybrano format papieru: ${name}`);
    }

    function selectPhotoPreset(w, h, name, presetType) {
      document.getElementById('photo-width').value = w;
      document.getElementById('photo-height').value = h;
      saveCustomDimensions();
      photoConfig.width = w;
      photoConfig.height = h;
      photoConfig.name = name;
      photoConfig.presetType = presetType;
      showToast(`Wybrano format: ${name}`);
    }

    function setPresetCustom() {
      photoConfig.presetType = 'custom';
      photoConfig.name = 'Własny format';
    }

    // --- KROKI WIZARDA ---
    function nextStep() {
      if (currentStep === 1) {
        paperConfig.width = parseFloat(document.getElementById('paper-width').value) || 210;
        paperConfig.height = parseFloat(document.getElementById('paper-height').value) || 297;
        saveCustomDimensions();
      } else if (currentStep === 2) {
        photoConfig.width = parseFloat(document.getElementById('photo-width').value) || 35;
        photoConfig.height = parseFloat(document.getElementById('photo-height').value) || 45;
        saveCustomDimensions();
        initCropCanvas();
      } else if (currentStep === 3) {
        if (!loadedImage) {
          showToast('Wgraj najpierw zdjęcie!');
          return;
        }
        renderSheetPreview();
      } else if (currentStep === 4) {
        updateSummary();
      }

      if (currentStep < 5) {
        currentStep++;
        updateStepUI();
      }
    }

    function prevStep() {
      if (currentStep > 1) {
        currentStep--;
        updateStepUI();
      }
    }

    function updateStepUI() {
      for (let i = 1; i <= 5; i++) {
        document.getElementById(`step-${i}`).classList.toggle('hidden', i !== currentStep);
        const navEl = document.getElementById(`wizard-step-${i}`);
        navEl.className = 'flex flex-col items-center flex-1 border-b-2 pb-1 text-xs font-medium transition-all ';
        if (i < currentStep) {
          navEl.classList.add('step-done');
        } else if (i === currentStep) {
          navEl.classList.add('step-active');
        } else {
          navEl.classList.add('border-slate-700', 'text-slate-500');
        }
      }

      document.getElementById('step-indicator-text').innerText = `Krok ${currentStep} z 5`;
      document.getElementById('btn-prev').disabled = currentStep === 1;
      
      const btnNext = document.getElementById('btn-next');
      if (currentStep === 5) {
        btnNext.classList.add('hidden');
      } else {
        btnNext.classList.remove('hidden');
      }

      lucide.createIcons();
    }

    // --- KROK 3: KADROWANIE ---
    function initCropCanvas() {
      const containerWidth = 320;
      const aspectRatio = photoConfig.height / photoConfig.width;
      
      cropCanvas.width = containerWidth * 2;
      cropCanvas.height = (containerWidth * aspectRatio) * 2;

      // Aktualizacja opisu podpowiedzi
      const guideText = document.getElementById('crop-guideline-text');
      if (photoConfig.presetType === 'dowod' || photoConfig.presetType === 'paszport') {
        guideText.innerText = 'Głowa (31–36 mm) powinna zajmować 70–80% wysokości zdjęcia.';
      } else if (photoConfig.presetType === 'wiza_usa') {
        guideText.innerText = 'Głowa (25–35 mm) powinna zajmować 50–69% wysokości zdjęcia.';
      } else if (photoConfig.presetType === 'legitymacja') {
        guideText.innerText = 'Dopasuj wyraźną twarz na jasnym tle.';
      } else {
        guideText.innerText = 'Ustaw i przeskaluj zdjęcie wewnątrz ramki.';
      }

      renderCropCanvas();
    }

    function handleImageLoad(file) {
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          loadedImage = img;
          document.getElementById('crop-placeholder').classList.add('hidden');
          document.getElementById('controls-container').classList.remove('hidden');

          const canvasAspect = cropCanvas.width / cropCanvas.height;
          const imgAspect = img.width / img.height;

          if (imgAspect > canvasAspect) {
            cropState.scale = cropCanvas.height / img.height;
          } else {
            cropState.scale = cropCanvas.width / img.width;
          }

          cropState.x = (cropCanvas.width - img.width * cropState.scale) / 2;
          cropState.y = (cropCanvas.height - img.height * cropState.scale) / 2;
          cropState.rotation = 0;

          document.getElementById('zoom-slider').value = 1;
          document.getElementById('zoom-value').innerText = '100%';
          document.getElementById('rotate-slider').value = 0;
          document.getElementById('rotate-value').innerText = '0°';

          renderCropCanvas();
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function renderCropCanvas() {
      const w = cropCanvas.width;
      const h = cropCanvas.height;

      cropCtx.clearRect(0, 0, w, h);

      if (loadedImage) {
        cropCtx.save();
        
        // Translacja do środka obrazu celem obrotu
        const centerX = cropState.x + (loadedImage.width * cropState.scale) / 2;
        const centerY = cropState.y + (loadedImage.height * cropState.scale) / 2;

        cropCtx.translate(centerX, centerY);
        cropCtx.rotate((cropState.rotation * Math.PI) / 180);
        cropCtx.drawImage(
          loadedImage,
          -(loadedImage.width * cropState.scale) / 2,
          -(loadedImage.height * cropState.scale) / 2,
          loadedImage.width * cropState.scale,
          loadedImage.height * cropState.scale
        );
        cropCtx.restore();
      }

      // --- NAKŁADKA ELIPSY BIOMETRYCZNEJ ---
      cropCtx.save();
      
      // Maska zaciemniająca
      cropCtx.fillStyle = 'rgba(0, 0, 0, 0.4)';
      cropCtx.fillRect(0, 0, w, h);

      const centerX = w / 2;
      let centerY = h * 0.45;

      // Wyznaczenie promieni elipsy w zależności od wymogów
      let headHeightRatio = 0.75; // Domyślnie 75% (Dowód/Paszport)
      if (photoConfig.presetType === 'wiza_usa') {
        headHeightRatio = 0.58; // 50-69% dla Wizy USA
        centerY = h * 0.48;
      } else if (photoConfig.presetType === 'legitymacja') {
        headHeightRatio = 0.65;
      }

      const radiusY = (h * headHeightRatio) / 2;
      const radiusX = radiusY * 0.78; // Proporcja szerokości głowy do wysokości

      // Wycięcie przezroczystej elipsy
      cropCtx.globalCompositeOperation = 'destination-out';
      cropCtx.beginPath();
      cropCtx.ellipse(centerX, centerY, radiusX, radiusY, 0, 0, 2 * Math.PI);
      cropCtx.fill();

      cropCtx.globalCompositeOperation = 'source-over';

      // Linia elipsy
      cropCtx.beginPath();
      cropCtx.ellipse(centerX, centerY, radiusX, radiusY, 0, 0, 2 * Math.PI);
      cropCtx.strokeStyle = '#3b82f6';
      cropCtx.lineWidth = 4;
      cropCtx.setLineDash([8, 6]);
      cropCtx.stroke();

      // Linie pomocnicze (Oczy / Czubek głowy)
      cropCtx.setLineDash([4, 4]);
      cropCtx.strokeStyle = 'rgba(234, 179, 8, 0.8)';
      cropCtx.lineWidth = 2;

      // Linia oczu
      const eyeY = centerY - radiusY * 0.1;
      cropCtx.beginPath();
      cropCtx.moveTo(centerX - radiusX * 0.85, eyeY);
      cropCtx.lineTo(centerX + radiusX * 0.85, eyeY);
      cropCtx.stroke();

      // Tekst pomocniczy
      cropCtx.fillStyle = '#ffffff';
      cropCtx.font = 'bold 16px Inter, sans-serif';
      cropCtx.textAlign = 'center';
      cropCtx.shadowColor = 'black';
      cropCtx.shadowBlur = 4;

      if (photoConfig.presetType === 'dowod' || photoConfig.presetType === 'paszport') {
        cropCtx.fillText('GŁOWA 70–80% (31–36 mm)', centerX, centerY + radiusY + 26);
      } else if (photoConfig.presetType === 'wiza_usa') {
        cropCtx.fillText('GŁOWA 50–69% (25–35 mm)', centerX, centerY + radiusY + 26);
      } else {
        cropCtx.fillText('OBSZAR TWARZY', centerX, centerY + radiusY + 26);
      }

      cropCtx.restore();
    }

    // --- GESTY DOTYKOWE & EVENTS ---
    let isDragging = false;
    let startX = 0, startY = 0;
    let initialPinchDist = null;
    let initialScale = 1;

    function setupEventListeners() {
      document.getElementById('file-input').addEventListener('change', (e) => handleImageLoad(e.target.files[0]));
      document.getElementById('camera-input').addEventListener('change', (e) => handleImageLoad(e.target.files[0]));

      const zoomSlider = document.getElementById('zoom-slider');
      zoomSlider.addEventListener('input', (e) => {
        if (!loadedImage) return;
        const factor = parseFloat(e.target.value);
        document.getElementById('zoom-value').innerText = `${Math.round(factor * 100)}%`;

        const centerX = cropCanvas.width / 2;
        const centerY = cropCanvas.height / 2;
        const baseScale = Math.min(cropCanvas.width / loadedImage.width, cropCanvas.height / loadedImage.height);
        const newScale = baseScale * factor;

        cropState.x = centerX - (centerX - cropState.x) * (newScale / cropState.scale);
        cropState.y = centerY - (centerY - cropState.y) * (newScale / cropState.scale);
        cropState.scale = newScale;

        renderCropCanvas();
      });

      const rotateSlider = document.getElementById('rotate-slider');
      rotateSlider.addEventListener('input', (e) => {
        if (!loadedImage) return;
        cropState.rotation = parseFloat(e.target.value);
        document.getElementById('rotate-value').innerText = `${cropState.rotation}°`;
        renderCropCanvas();
      });

      document.getElementById('toggle-grid-lines').addEventListener('change', () => {
        renderSheetPreview();
      });

      // Drag myszą
      cropCanvas.addEventListener('mousedown', (e) => {
        if (!loadedImage) return;
        isDragging = true;
        startX = e.clientX - cropState.x;
        startY = e.clientY - cropState.y;
      });

      window.addEventListener('mousemove', (e) => {
        if (!isDragging || !loadedImage) return;
        cropState.x = e.clientX - startX;
        cropState.y = e.clientY - startY;
        renderCropCanvas();
      });

      window.addEventListener('mouseup', () => isDragging = false);

      // Touch gesty (Smartfony)
      cropCanvas.addEventListener('touchstart', (e) => {
        if (!loadedImage) return;
        if (e.touches.length === 1) {
          isDragging = true;
          startX = e.touches[0].clientX - cropState.x;
          startY = e.touches[0].clientY - cropState.y;
        } else if (e.touches.length === 2) {
          isDragging = false;
          initialPinchDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          initialScale = cropState.scale;
        }
      }, { passive: true });

      cropCanvas.addEventListener('touchmove', (e) => {
        if (!loadedImage) return;
        if (isDragging && e.touches.length === 1) {
          cropState.x = e.touches[0].clientX - startX;
          cropState.y = e.touches[0].clientY - startY;
          renderCropCanvas();
        } else if (e.touches.length === 2 && initialPinchDist) {
          const currentDist = Math.hypot(
            e.touches[0].clientX - e.touches[1].clientX,
            e.touches[0].clientY - e.touches[1].clientY
          );
          const factor = currentDist / initialPinchDist;
          cropState.scale = initialScale * factor;

          const baseScale = Math.min(cropCanvas.width / loadedImage.width, cropCanvas.height / loadedImage.height);
          const sliderVal = cropState.scale / baseScale;
          zoomSlider.value = sliderVal;
          document.getElementById('zoom-value').innerText = `${Math.round(sliderVal * 100)}%`;

          renderCropCanvas();
        }
      }, { passive: true });

      cropCanvas.addEventListener('touchend', () => {
        isDragging = false;
        initialPinchDist = null;
      });
    }

    // --- CZYSTE ZDJĘCIE DO DRUKU ---
    function getCroppedPhotoCanvas() {
      const cleanCanvas = document.createElement('canvas');
      const dpiScale = 4;
      cleanCanvas.width = photoConfig.width * dpiScale * 10;
      cleanCanvas.height = photoConfig.height * dpiScale * 10;
      const ctx = cleanCanvas.getContext('2d');

      const scaleRatioX = cleanCanvas.width / cropCanvas.width;
      const scaleRatioY = cleanCanvas.height / cropCanvas.height;

      ctx.save();
      const centerX = (cropState.x + (loadedImage.width * cropState.scale) / 2) * scaleRatioX;
      const centerY = (cropState.y + (loadedImage.height * cropState.scale) / 2) * scaleRatioY;

      ctx.translate(centerX, centerY);
      ctx.rotate((cropState.rotation * Math.PI) / 180);
      ctx.drawImage(
        loadedImage,
        -((loadedImage.width * cropState.scale) / 2) * scaleRatioX,
        -((loadedImage.height * cropState.scale) / 2) * scaleRatioY,
        loadedImage.width * cropState.scale * scaleRatioX,
        loadedImage.height * cropState.scale * scaleRatioY
      );
      ctx.restore();

      return cleanCanvas;
    }

    // --- KROK 4: RENDERING ARKUSZA ---
    function renderSheetPreview() {
      if (!loadedImage) return;

      const pW = paperConfig.width;
      const pH = paperConfig.height;
      const fW = photoConfig.width;
      const fH = photoConfig.height;

      const margin = 5; 
      const spacing = 2;

      const availW = pW - margin * 2;
      const availH = pH - margin * 2;

      const cols = Math.floor((availW + spacing) / (fW + spacing));
      const rows = Math.floor((availH + spacing) / (fH + spacing));
      const count = cols * rows;

      calculatedGrid = { cols, rows, count, spacing };

      document.getElementById('sheet-info-text').innerText = 
        `Rozmieszczono ${count} szt. (${cols} kolumn × ${rows} wierszy)`;

      const previewMaxDim = 600;
      let cW, cH;
      if (pW >= pH) {
        cW = previewMaxDim;
        cH = previewMaxDim * (pH / pW);
      } else {
        cH = previewMaxDim;
        cW = previewMaxDim * (pW / pH);
      }

      sheetCanvas.width = cW * 2;
      sheetCanvas.height = cH * 2;

      sheetCtx.fillStyle = '#ffffff';
      sheetCtx.fillRect(0, 0, sheetCanvas.width, sheetCanvas.height);

      const photoImg = getCroppedPhotoCanvas();

      const scaleX = sheetCanvas.width / pW;
      const scaleY = sheetCanvas.height / pH;

      const gridTotalW = cols * fW + (cols - 1) * spacing;
      const gridTotalH = rows * fH + (rows - 1) * spacing;
      const startX = (pW - gridTotalW) / 2;
      const startY = (pH - gridTotalH) / 2;

      const drawLines = document.getElementById('toggle-grid-lines').checked;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const xMM = startX + c * (fW + spacing);
          const yMM = startY + r * (fH + spacing);

          const xPX = xMM * scaleX;
          const yPX = yMM * scaleY;
          const wPX = fW * scaleX;
          const hPX = fH * scaleY;

          sheetCtx.drawImage(photoImg, xPX, yPX, wPX, hPX);

          if (drawLines) {
            sheetCtx.strokeStyle = '#cbd5e1';
            sheetCtx.lineWidth = 1.5;
            sheetCtx.strokeRect(xPX, yPX, wPX, hPX);
          }
        }
      }
    }

    // --- KROK 5: POBIERANIE ---
    function updateSummary() {
      document.getElementById('summary-paper').innerText = `${paperConfig.name} (${paperConfig.width} × ${paperConfig.height} mm)`;
      document.getElementById('summary-photo').innerText = `${photoConfig.name} (${photoConfig.width} × ${photoConfig.height} mm)`;
      document.getElementById('summary-count').innerText = `${calculatedGrid.count} szt.`;
    }

    function downloadImage(format) {
      const dpi = 300;
      const mmToPx = dpi / 25.4;

      const exportCanvas = document.createElement('canvas');
      exportCanvas.width = Math.round(paperConfig.width * mmToPx);
      exportCanvas.height = Math.round(paperConfig.height * mmToPx);
      const ctx = exportCanvas.getContext('2d');

      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, exportCanvas.width, exportCanvas.height);

      const photoImg = getCroppedPhotoCanvas();
      const { cols, rows, spacing } = calculatedGrid;
      const fW = photoConfig.width;
      const fH = photoConfig.height;

      const gridTotalW = cols * fW + (cols - 1) * spacing;
      const gridTotalH = rows * fH + (rows - 1) * spacing;
      const startX = (paperConfig.width - gridTotalW) / 2;
      const startY = (paperConfig.height - gridTotalH) / 2;

      const drawLines = document.getElementById('toggle-grid-lines').checked;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const xMM = startX + c * (fW + spacing);
          const yMM = startY + r * (fH + spacing);

          const xPX = xMM * mmToPx;
          const yPX = yMM * mmToPx;
          const wPX = fW * mmToPx;
          const hPX = fH * mmToPx;

          ctx.drawImage(photoImg, xPX, yPX, wPX, hPX);

          if (drawLines) {
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 2;
            ctx.strokeRect(xPX, yPX, wPX, hPX);
          }
        }
      }

      const link = document.createElement('a');
      link.download = `fotodruk_${paperConfig.width}x${paperConfig.height}mm_${photoConfig.width}x${photoConfig.height}mm.${format}`;
      link.href = exportCanvas.toDataURL(`image/${format === 'jpg' ? 'jpeg' : 'png'}`, 0.95);
      link.click();

      showToast(`Pobrano plik ${format.toUpperCase()}`);
    }

    function downloadPDF() {
      const { jsPDF } = window.jspdf;
      const orientation = paperConfig.width > paperConfig.height ? 'l' : 'p';
      
      const pdf = new jsPDF({
        orientation: orientation,
        unit: 'mm',
        format: [paperConfig.width, paperConfig.height]
      });

      const photoImg = getCroppedPhotoCanvas();
      const photoDataUrl = photoImg.toDataURL('image/jpeg', 0.95);

      const { cols, rows, spacing } = calculatedGrid;
      const fW = photoConfig.width;
      const fH = photoConfig.height;

      const gridTotalW = cols * fW + (cols - 1) * spacing;
      const gridTotalH = rows * fH + (rows - 1) * spacing;
      const startX = (paperConfig.width - gridTotalW) / 2;
      const startY = (paperConfig.height - gridTotalH) / 2;

      const drawLines = document.getElementById('toggle-grid-lines').checked;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const xMM = startX + c * (fW + spacing);
          const yMM = startY + r * (fH + spacing);

          pdf.addImage(photoDataUrl, 'JPEG', xMM, yMM, fW, fH);

          if (drawLines) {
            pdf.setDrawColor(200, 200, 200);
            pdf.setLineWidth(0.1);
            pdf.rect(xMM, yMM, fW, fH);
          }
        }
      }

      pdf.save(`fotodruk_${paperConfig.width}x${paperConfig.height}mm.pdf`);
      showToast('Pobrano arkusz jako PDF');
    }
  </script>
</body>
</html>
